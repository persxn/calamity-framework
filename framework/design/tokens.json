{
  "name": "Calamity Paper",
  "version": 1,
  "date": "2026-10-28",
  "note": "The one source of the design system. tools/design.py writes calamity.sty, calamity.css, palette.svg and the terminal themes from it; edit this file, never the outputs.",
  "fonts": {
    "body": {"name": "XCharter", "otf": ["XCharter", "-Roman", "-Bold", "-Italic", "-BoldItalic"], "pdflatex": "XCharter", "css": "Charter, 'Bitstream Charter', 'XCharter', 'Sitka Text', Cambria, Georgia, serif"},
    "sans": {"name": "Fira Sans", "otf": ["FiraSans", "-Regular", "-SemiBold", "-Italic", "-SemiBoldItalic"], "pdflatex": "FiraSans", "css": "'Fira Sans', 'Segoe UI', system-ui, -apple-system, sans-serif"},
    "mono": {"name": "Fira Mono", "otf": ["FiraMono", "-Regular", "-Bold", "-Regular", "-Bold"], "pdflatex": "FiraMono", "css": "'Fira Mono', 'Fira Code', ui-monospace, Menlo, Consolas, monospace"},
    "math": {"name": "XCharter Math", "otf": "XCharter-Math.otf", "pdflatex": "newtxmath:xcharter"}
  },
  "type": {
    "base_pt": 11,
    "line": 1.45,
    "scale": {"small": 0.875, "base": 1.0, "h3": 1.125, "h2": 1.375, "h1": 1.75, "title": 2.25}
  },
  "space": {"unit_pt": 4, "box_pad_x": 8, "box_pad_y": 5, "box_edge": 2.5, "box_gap": 10},
  "palette": {
    "light": {
      "ink": "1F2328", "muted": "57606A", "rule": "8A8F98", "paper": "FFFFFF", "surface": "F6F6F4",
      "accent": "1F4E8C", "teal": "0F766E", "green": "3B6E3B", "amber": "A4511B", "red": "B42318",
      "violet": "6D28D9", "slate": "475569", "code_keyword": "1F4E8C", "code_string": "8A3B12", "code_comment": "5F6B5F"
    },
    "dark": {
      "ink": "E6E4DF", "muted": "A3A9B1", "rule": "5A606A", "paper": "16171A", "surface": "202226",
      "accent": "7FA7DB", "teal": "5CC2B5", "green": "8CC08C", "amber": "E39A63", "red": "F07A6E",
      "violet": "B49CF2", "slate": "9AA7B8", "code_keyword": "8FB3E3", "code_string": "E3A27A", "code_comment": "9AA59A"
    }
  },
  "tint": 0.07,
  "callouts": [
    {"kind": "idea",          "env": "keyidea",       "label": "Key idea",                  "colour": "accent"},
    {"kind": "plain",         "env": "plainwords",    "label": "In plain words",            "colour": "accent"},
    {"kind": "mechanism",     "env": "underthehood",  "label": "Under the hood",            "colour": "teal"},
    {"kind": "design",        "env": "designnote",    "label": "Designer's note",           "colour": "teal"},
    {"kind": "example",       "env": "tryit",         "label": "Try it",                    "colour": "green"},
    {"kind": "pitfall",       "env": "pitfall",       "label": "Pitfall",                   "colour": "amber", "aliases": ["gotcha"]},
    {"kind": "misconception", "env": "misconception", "label": "Common misconception",      "colour": "amber"},
    {"kind": "history",       "env": "origin",        "label": "Origin story",              "colour": "slate"},
    {"kind": "scale",         "env": "scale",         "label": "At scale",                  "colour": "slate"},
    {"kind": "vocabulary",    "env": "vocab",         "label": "Vocabulary",                "colour": "slate"},
    {"kind": "outage",        "env": "outage",        "label": "From the outage files",     "colour": "red"},
    {"kind": "ai-era",        "env": "aiwatch",       "label": "When the AI gets it wrong", "colour": "red"},
    {"kind": "interview",     "env": "interview",     "label": "Interview corner",          "colour": "violet"}
  ],
  "terminal": {
    "light": ["1F2328", "B42318", "3B6E3B", "A4511B", "1F4E8C", "6D28D9", "0F766E", "D0D3D8",
              "57606A", "D1432F", "4E8A4E", "C26A2E", "2F68B5", "8B5CF6", "14958A", "FFFFFF"],
    "dark":  ["16171A", "F07A6E", "8CC08C", "E39A63", "7FA7DB", "B49CF2", "5CC2B5", "C8C6C1",
              "5A606A", "F59A90", "A8D4A8", "EDB487", "A3C2EA", "CDBCF7", "86D6CC", "E6E4DF"]
  }
}
