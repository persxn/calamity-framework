\ifPDFTeX
  \RequirePackage[utf8]{inputenc}
  \IfFileExists{XCharter.sty}{%
    \RequirePackage[T1]{fontenc}\RequirePackage{XCharter}%
  }{\IfFileExists{lmodern.sty}{\RequirePackage[T1]{fontenc}\RequirePackage{lmodern}}{}}
  \IfFileExists{FiraSans.sty}{\RequirePackage[scale=0.92,lining]{FiraSans}}{}
  \IfFileExists{FiraMono.sty}{\RequirePackage[scale=0.86,lining]{FiraMono}}{}
  \IfFileExists{newtxmath.sty}{\IfFileExists{XCharter.sty}{\RequirePackage[xcharter]{newtxmath}}{\RequirePackage{amssymb}}}{\RequirePackage{amssymb}}
\else
  \RequirePackage{fontspec}
  \IfFontExistsTF{XCharter-Roman.otf}{\setmainfont{XCharter}[Extension=.otf,UprightFont=*-Roman,BoldFont=*-Bold,ItalicFont=*-Italic,BoldItalicFont=*-BoldItalic]}{}
  \IfFontExistsTF{FiraSans-Regular.otf}{\setsansfont{FiraSans}[Extension=.otf,UprightFont=*-Regular,BoldFont=*-SemiBold,ItalicFont=*-Italic,BoldItalicFont=*-SemiBoldItalic,Scale=MatchLowercase]}{}
  \IfFontExistsTF{FiraMono-Regular.otf}{\setmonofont{FiraMono}[Extension=.otf,UprightFont=*-Regular,BoldFont=*-Bold,ItalicFont=*-Regular,BoldItalicFont=*-Bold,Scale=MatchLowercase]}{}
  \RequirePackage{unicode-math}
  \IfFontExistsTF{XCharter-Math.otf}{\setmathfont{XCharter-Math.otf}}{}
  % amssymb names that unicode-math spells differently, so a section builds on every engine
  \AtBeginDocument{\providecommand{\square}{\mdlgwhtsquare}\providecommand{\blacksquare}{\mdlgblksquare}%
    \providecommand{\lozenge}{\mdlgwhtlozenge}\providecommand{\blacklozenge}{\mdlgblklozenge}%
    \let\Box\mdlgwhtsquare\let\Diamond\mdlgwhtdiamond}
\fi
