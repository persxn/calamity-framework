% ---------------------------------------------------------------- books only
\ifcal@book
  % \svgfigure[width]{name}{caption}{label}: figures/src/name.svg, built to figures/build/name.pdf
  \newcommand{\svgfigure}[4][0.92\linewidth]{\begin{figure}[htbp]\centering
    \IfFileExists{figures/build/#2.pdf}{\includegraphics[width=#1]{figures/build/#2.pdf}}{%
      \PackageWarning{calamity}{MISSING FIGURE #2}%
      \fcolorbox{calRed}{white}{\parbox{0.8\linewidth}{\centering\sffamily\color{calRed}
        MISSING FIGURE: \texttt{\detokenize{#2}}}}}%
    \caption{#3}\label{#4}\end{figure}}
  % \begin{exercise}[difficulty 1 recall, 2 apply, 3 interview, 4 project]{ex:label} ... \end{exercise};
  % \begin{solution}{ex:label} ... \end{solution}
  \newcounter{exercise}[chapter]
  \renewcommand{\theexercise}{\thechapter.\arabic{exercise}}
  \newcommand{\cal@stars}[1]{{\color{calAmber}\ifcase#1\or$\star$\or$\star\star$\or$\star\star\star$\or$\star\star\star\star$\fi}}
  \newcommand{\cal@kind}[1]{\ifcase#1\or Recall\or Apply\or Interview\or Project\fi}
  \newenvironment{exercise}[2][2]{\refstepcounter{exercise}\label{#2}\par\medskip\noindent
    {\sffamily\bfseries Exercise \theexercise}\ \cal@stars{#1}\ {\sffamily\footnotesize\color{calSlate}\cal@kind{#1}}%
    \par\nobreak\noindent\ignorespaces}{\par}
  \newenvironment{solution}[1]{\par\medskip\noindent{\sffamily\bfseries Solution to Exercise~\ref{#1}}%
    \par\nobreak\noindent\ignorespaces}{\par}
  \newcommand{\chaptersummary}{\section*{Chapter summary}\addcontentsline{toc}{section}{Chapter summary}}
  \newcommand{\chaptervocab}{\section*{Vocabulary}\addcontentsline{toc}{section}{Vocabulary}}
  \newcommand{\chapterexercises}{\section*{Exercises}\addcontentsline{toc}{section}{Exercises}}
  \newcommand{\furtherreading}{\section*{Further reading}\addcontentsline{toc}{section}{Further reading}}
