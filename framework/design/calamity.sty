% ---------------------------------------------------------------- inline technical text
% \code{git rebase -i}, \cmd{ls -la}, \flag{--force}, \file{/etc/hosts}: literal, dashes and _ ^ & $ ~ kept
% (not % # or unbalanced braces: use \lstinline|...|). \term{idempotent}: a term defined here (indexed in a book).
% \bigO{n \log n}: complexity. \key{Ctrl}: a key on the keyboard.
\newcommand{\code}[1]{\texttt{\detokenize{#1}}}
\newcommand{\cmd}[1]{\texttt{\detokenize{#1}}}
\newcommand{\flag}[1]{\texttt{\detokenize{#1}}}
\newcommand{\file}[1]{\texttt{\detokenize{#1}}}
\ifcal@book\newcommand{\term}[1]{\emph{#1}\index{#1}}\else\newcommand{\term}[1]{\emph{#1}}\fi
\newcommand{\bigO}[1]{\ensuremath{\mathcal{O}(#1)}}
\newcommand{\key}[1]{\fbox{\sffamily\footnotesize #1}}

% ---------------------------------------------------------------- code listings
% Listings are plain ASCII. \begin{lstlisting}[language=Python,caption={...}]; in a book also \begin{codeblock}
% and \begin{shell} (a "$ " prompt line is bold). \code{...} is inline code in both options.
\lstdefinestyle{calcode}{basicstyle=\ttfamily\small,columns=fullflexible,keepspaces=true,breaklines=true,
  breakatwhitespace=false,showstringspaces=false,tabsize=2,upquote=true,backgroundcolor=\color{calSurface},
  frame=l,framerule=2pt,rulecolor=\color{calRule!60},xleftmargin=10pt,framexleftmargin=6pt,aboveskip=0.8em,
  belowskip=0.6em,captionpos=b,keywordstyle=\color{calCodeKeyword}\bfseries,stringstyle=\color{calCodeString},
  commentstyle=\color{calCodeComment}\itshape,numberstyle=\tiny\color{calRule}}
\lstset{style=calcode}
\ifcal@book
  \lstdefinestyle{calshell}{style=calcode,language=bash,keywordstyle=\color{calInk},
    moredelim=[il][\color{calGreen}\bfseries]{\$\ },literate={\$}{{\textcolor{calGreen}{\$}}}1}
  \lstnewenvironment{shell}[1][]{\lstset{style=calshell,#1}}{}
  \lstnewenvironment{codeblock}[1][]{\lstset{style=calcode,#1}}{}
\fi
