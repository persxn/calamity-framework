% ---------------------------------------------------------------- callouts
% \begin{keyidea}[optional subtitle] ... \end{keyidea}; every kind is listed in the tokens block above.
% Book: tcolorbox, breakable. Notebook: a tinted box with a coloured edge, unbreakable (keep it short).
\newcommand{\cal@subtitle}[1]{\if\relax\detokenize{#1}\relax\else\ --- #1\fi}
\ifcal@book
  \newcommand{\cal@callout}[3]{%
    \newtcolorbox{#1}[1][]{enhanced,breakable,colback=#3!7!white,colframe=#3,
      boxrule=0pt,leftrule=2.5pt,arc=1pt,outer arc=1pt,left=8pt,right=8pt,top=5pt,bottom=5pt,
      before skip=10pt,after skip=10pt,fonttitle=\sffamily\bfseries\small,coltitle=#3,colbacktitle=#3!7!white,
      attach title to upper,after title={\par\smallskip},title={#2\cal@subtitle{##1}}}}
  \newtcolorbox{definition}[1]{enhanced,breakable,colback=calAccent!7!white,colframe=calAccent,
    boxrule=0.6pt,arc=2pt,left=8pt,right=8pt,top=5pt,bottom=5pt,
    before skip=10pt,after skip=10pt,fonttitle=\sffamily\bfseries\small,coltitle=white,colbacktitle=calAccent,
    title={Definition: #1}}
\else
  \newsavebox{\cal@box}
  \newcommand{\cal@open}[3]{\def\cal@edge{#2}\par\medskip\noindent
    \begin{lrbox}{\cal@box}\begin{minipage}{\dimexpr\linewidth-2.5pt-2\dimexpr8pt\relax\relax}%
    \setlength{\parskip}{0.4em}\vspace{5pt}{\sffamily\bfseries\color{#2}#1\cal@subtitle{#3}.}\ \ignorespaces}
  \newcommand{\cal@close}{\par\vspace{5pt}\end{minipage}\end{lrbox}%
    {\setlength{\fboxsep}{0pt}\colorbox{\cal@edge!7!white}{{\color{\cal@edge}\vrule width 2.5pt}%
    \hspace{8pt}\usebox{\cal@box}\hspace{8pt}}}\par\medskip}
  \newcommand{\cal@callout}[3]{\newenvironment{#1}[1][]{\cal@open{#2}{#3}{##1}}{\cal@close}}
  \newenvironment{definition}[1]{\cal@open{Definition}{calAccent}{#1}}{\cal@close}
\fi
\newcommand{\cal@alias}[2]{\newenvironment{#1}[1][]{\begin{#2}[##1]}{\end{#2}}}
\cal@callout{keyidea}{Key idea}{calAccent}
\cal@callout{plainwords}{In plain words}{calAccent}
\cal@callout{underthehood}{Under the hood}{calTeal}
\cal@callout{designnote}{Designer's note}{calTeal}
\cal@callout{tryit}{Try it}{calGreen}
\cal@callout{pitfall}{Pitfall}{calAmber}
\cal@alias{gotcha}{pitfall}
\cal@callout{misconception}{Common misconception}{calAmber}
