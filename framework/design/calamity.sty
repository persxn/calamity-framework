% Fonts: XCharter body, Fira Sans headings, Fira Mono code, XCharter Math; each falls back to Latin Modern when it is not installed, so a minimal
% TeX still builds. Both options define the same names (callouts, \term, \code, \cmd, recall, mistakes),
% so a section written for the notebook drops into a book unchanged.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{calamity}[2026/10/28 Calamity Paper v1]

\newif\ifcal@book
\DeclareOption{notebook}{\cal@bookfalse}
